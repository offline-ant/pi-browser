{
  "name": "pi-browser",
  "version": "0.1.0",
  "description": "Shared Chromium/Firefox automation and Codex or browser-backed web tools for Pi and SDK applications",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "browser", "web-search"],
  "engines": { "node": ">=24.0.0" },
  "exports": {
    ".": { "types": "./dist/core/index.d.ts", "default": "./dist/core/index.js" },
    "./web": { "types": "./dist/web/index.d.ts", "default": "./dist/web/index.js" },
    "./extension": "./dist/extension.js",
    "./cdp": { "types": "./dist/core/cdp.d.ts", "default": "./dist/core/cdp.js" },
    "./bidi": { "types": "./dist/core/bidi.d.ts", "default": "./dist/core/bidi.js" }
  },
  "files": ["dist", "bin/browser-open", "README.md"],
  "pi": { "extensions": ["./dist/extension.js"] },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "compile": "tsc -p tsconfig.emit.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "typebox": "1.3.7",
    "@types/node": "22.19.19",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "ws": "8.21.3"
  }
}
